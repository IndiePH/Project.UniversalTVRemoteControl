{
  "name": "one-remote-functions",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
